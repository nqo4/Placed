# 이 파일을 복사해서 .env 로 저장하고 실제 값을 채워 넣으세요.
# .env는 .gitignore에 포함되어 있어 커밋되지 않습니다.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL 접속 정보.
# Render에 배포하면 Render가 DATABASE_URL을 자동으로 주입하므로 이 블록은 무시됩니다.
# 로컬 개발에서는 DATABASE_URL을 직접 넣거나(둘 중 하나만 설정하면 됨), 아래 DB_* 값으로
# 로컬에 설치한 PostgreSQL 접속 정보를 구성하세요.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placed
DB_NAME=placed
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# 2026-08, 네이버 검색 오픈API가 NAVER Cloud Platform의 NAVER API HUB로 이관되었습니다.
# 아래 두 값은 (기존 개발자센터가 아니라) NAVER API HUB에서 새로 발급받은 Client ID/Secret을
# 넣어야 합니다. 엔드포인트가 다시 바뀌면 NAVER_API_BASE_URL만 바꾸면 됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_BASE_URL=https://naverapihub.apigw.ntruss.com/search/v1

# 카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키 (Daum 이미지 검색으로 장소 사진을 찾을 때 사용)
KAKAO_REST_API_KEY=

# 검색 결과에서 광고로 판단해 제외할 기준선 (0~100, ad_probability 기준)
AD_EXCLUDE_THRESHOLD=70
